# news-tts-agent 环境变量配置示例

# ============================================
# LLM 配置
# ============================================
# LLM 服务模式: qianfan (推荐), openrouter, sidecar
LLM_MODE=qianfan

# 百度千帆配置（默认）
QIANFAN_API_KEY=bce-v3/ALTAK-4M1PjF9xgxKB0baLF7VOT/95383565f560515a9182ec061647ffcadc918470
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_MODEL=qwen3-32b

# # OpenRouter配置（备用）
# OPENROUTER_API_KEY=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
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=qwen/qwen3-4b:free

# Sidecar配置（生产环境）
# LLM_API_KEY=zbx:...
# SIDECAR_BASE_URL=http://10.109.253.54:8001/v1
# SIDECAR_MODEL=Qwen2.5-7B-Instruct

# 文本chunk合并配置
TEXT_CHUNK_MIN_SIZE=20      # 最小累积字符数
TEXT_CHUNK_MAX_SIZE=80      # 最大累积字符数
TEXT_CHUNK_TIMEOUT=0.3      # 最大等待时间（秒）
TEXT_CHUNK_SENTENCE_ENDINGS="。！？.!?；;"  # 句子结束标点

# ============================================
# TTS配置
# ============================================
# 切换到 DashScope 服务
TTS_SERVICE_TYPE=dashscope

# 配置 API Key（必需）
DASHSCOPE_API_KEY=sk-5318d3799b4340a299f583cda39edb27
# 可选配置
DASHSCOPE_MODEL=qwen3-tts-flash
DASHSCOPE_VOICE=Cherry
DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_SAMPLE_RATE=24000

# 本地 TTS 模型目录路径
TTS_LOCAL_MODEL_DIR=/data/models/CosyVoice2-0_5B

# 本地 TTS 模型类型: auto (自动检测), cosyvoice2, cosyvoice3
TTS_LOCAL_MODEL_TYPE=auto

# 默认说话人 ID
TTS_DEFAULT_SPK_ID=woman


MOCK_ALL=false
# ============================================
# TTS 流式合成性能参数
# ============================================
# 句子缓冲区配置

# 最小句子长度（字符数）
# 达到此长度且有句子结束标点时才输出
# - 快速响应模式: 5-10（适合实时对话）
# - 平衡模式: 10-20（适合新闻播报）

# - 高效模式: 20-50（适合长文本朗读）
TTS_MIN_LENGTH=15

# 最大句子长度（字符数）
# 超过此长度会强制分割，建议范围: 150-500
TTS_MAX_LENGTH=200

# 最大等待时间（秒）
# 超时后强制输出缓冲区内容
# - 快速响应: 1.0-2.0 秒
# - 平衡模式: 0.5-1.0 秒
# - 高效模式: 0.2-0.5 秒
TTS_MAX_WAIT_TIME=1.0

# 输出音频块大小（token数）
TTS_TOKEN_HOP_LEN=500

# 边界平滑缓存长度（仅CosyVoice2支持）
# 较小的值可以降低延迟，但可能影响音频边界平滑度
# 建议范围: 3-10
TTS_MEL_CACHE_LEN=10

# ============================================
# TTS 加速配置（方案C: TensorRT加速）
# ============================================
# 是否启用 FP16 精度推理（2倍速度提升，显存减半）
TTS_FP16=true

# 是否启用 TensorRT 加速（flow模型1.5-2倍加速）
TTS_TENSORRT=false

# TensorRT 并发数（建议根据GPU显存调整）
# RTX A4000 (16GB): 建议4-8
# RTX 3090 (24GB): 建议8-16
# RTX 4090 (24GB): 建议8-16
TTS_TENSORRT_CONCURRENT=4

# 是否启用 vLLM 加速（LLM部分3-5倍加速，需要额外依赖）
# 注意: 启用vLLM需要安装额外的依赖包
TTS_VLLM=false

# TensorRT engine 缓存目录（可选，加速后续启动）
# TTS_TENSORRT_CACHE_DIR=./tensorrt_cache

# ============================================
# TTS Orchestrator 配置（方案B）
# ============================================
# 等待TTS任务完成的超时时间（秒）
# 建议值: 30-60秒，取决于文本长度
TTS_MAX_WAIT_FOR_TTS=80.0

# 是否启用TTS模型预热（启动时预热，降低首次请求延迟）
TTS_ENABLE_WARMUP=true

# 预热超时时间（秒）
TTS_WARMUP_TIMEOUT=15.0

# ============================================
# 爬虫配置
# ============================================
# 爬虫数据库路径
CRAWLER_DB_PATH=data/news.db

# 爬取间隔（小时）
CRAWLER_INTERVAL_HOURS=1

# ============================================
# 定时任务配置
# ============================================
# 是否启用定时任务
ENABLE_SCHEDULER=true

# 时区设置
SCHEDULER_TIMEZONE=Asia/Shanghai

# 任务持久化
SCHEDULER_PERSIST_JOBS=true

# 持久化数据库路径
SCHEDULER_JOBS_DB_PATH=data/scheduler_jobs.db

# 每日爬取任务
DAILY_CRAWL_ENABLED=true
DAILY_CRAWL_HOUR=8
DAILY_CRAWL_MINUTE=0
DAILY_CRAWL_DAYS_TO_KEEP=7
DAILY_CRAWL_CLEAR_BEFORE=false

# 定时清理任务
CLEANUP_ENABLED=true
CLEANUP_HOUR=3
CLEANUP_MINUTE=0
CLEANUP_DAYS_TO_KEEP=30

# 健康检查任务
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# 每周清除所有数据任务
WEEKLY_CLEAR_ENABLED=false
WEEKLY_CLEAR_DAY=sun
WEEKLY_CLEAR_HOUR=21
WEEKLY_CLEAR_MINUTE=0
# ==================== 其他配置 ====================
# 日志配置
LOG_LEVEL=INFO

# API配置
API_HOST=0.0.0.0
API_PORT=8080
API_DEBUG=false

ENABLE_LLM_THINKING=true